---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudyBucketLabel, getEvidenceLevelLabel } from '../../utils/taxonomy';

export async function getStaticPaths() {
  const caseStudies = await getCollection(
    'case-studies',
    ({ data }) => data.status === 'published'
  );
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const receiptGroups = await getCollection('receipts', ({ data }) => data.status === 'published');

const receiptTypes = new Map([
  ['primary-documents', 'Primary documents'],
  ['official-data', 'Official data'],
  ['independent-analysis', 'Independent analysis'],
  ['direct-observation', 'Direct observation'],
]);

const receiptTags = (study.data.receiptTags ?? []).map((tag: string) => ({
  id: tag,
  label: receiptTypes.get(tag) ?? tag.replaceAll('-', ' '),
}));

const relatedReceiptGroups = receiptGroups.filter((group) =>
  (group.data.linkedCaseSlugs ?? []).includes(study.slug)
);

const relatedMethodTypes = [
  ...new Set(relatedReceiptGroups.map((group) => group.data.typeId).filter(Boolean)),
].map((typeId) => ({
  id: typeId,
  label: receiptTypes.get(typeId) ?? typeId.replaceAll('-', ' '),
  count: relatedReceiptGroups.filter((group) => group.data.typeId === typeId).length,
}));
---

<BaseLayout title={`${study.data.title} | Case Studies | Economy for Everyone`}>
  <section class="section-grid prose-e4e">
    <p class="detail-top-actions no-print">
      <a href="/case-studies">Back to case studies</a>
      <span class="detail-action-group">
        <button
          type="button"
          class="print-button icon-button"
          data-print-page
          title="Opens your browser print dialog."
          aria-label="Print or save as PDF"
        >
          <span aria-hidden="true">[pdf]</span>
        </button>
      </span>
    </p>

    <div class="ledger-header">
      <h2 class="title-reset">{study.data.title}</h2>
      <p class="muted-note">
        {getCaseStudyBucketLabel(study.data.bucket)} | {
          study.data.studyDate.toISOString().slice(0, 10)
        }
      </p>
    </div>

    <div class="panel receipt-card">
      <p><strong>Core pattern:</strong> {study.data.corePattern}</p>
      <p><strong>Claim:</strong> {study.data.claim}</p>
      {study.data.summary && <p>{study.data.summary}</p>}
      <p class="muted-note">
        <strong>Evidence level:</strong>
        {getEvidenceLevelLabel(study.data.evidenceLevel)}
        {
          study.data.eventWindowStart && study.data.eventWindowEnd
            ? ` | Event window: ${study.data.eventWindowStart.toISOString().slice(0, 10)} to ${study.data.eventWindowEnd.toISOString().slice(0, 10)}`
            : ''
        }
      </p>
    </div>

    {
      receiptTags.length > 0 && (
        <p class="case-meta-inline muted-note">
          <strong>Receipts:</strong> tracked in Methods and Sources by type:{' '}
          {receiptTags.map((tag, index) => (
            <>
              {index > 0 && ' | '}
              <a href={`/methods-and-sources#receipt-${tag.id}`}>{tag.label}</a>
            </>
          ))}
        </p>
      )
    }
    <Content />

    {
      relatedReceiptGroups.length > 0 && (
        <div class="panel">
          <p class="eyebrow">Related methods</p>
          <p class="muted-note">
            <a href={`/methods-and-sources?case=${study.slug}#receipt-groups`}>
              View receipt groups filtered to this case study
            </a>
          </p>
          {relatedMethodTypes.length > 0 && (
            <p class="muted-note">
              <strong>By type:</strong>{' '}
              {relatedMethodTypes.map((type, index) => (
                <>
                  {index > 0 && ' | '}
                  <a
                    href={`/methods-and-sources?case=${study.slug}&type=${type.id}#receipt-groups`}
                  >
                    {type.label} ({type.count})
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      )
    }

    <p>
      <a href="/case-studies">Back to case studies</a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-print-page]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>
