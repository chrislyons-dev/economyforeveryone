---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogBrowser from '../../components/BlogBrowser';
import { shouldShowScheduledPost } from '../../utils/blog-schedule';
import {
  canonicalizeBlogTopics,
  canonicalizeTags,
  getBlogCategoryLabel,
  getSourceChannelLabel,
  toCanonicalBlogCategory,
} from '../../utils/taxonomy';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const visiblePosts = posts.filter((post) =>
  shouldShowScheduledPost(post.data.pubDate.toISOString(), false, post.data.earlyRelease ?? false)
);

const postIndex = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  updatedDate: post.data.updatedDate ? post.data.updatedDate.toISOString() : null,
  category: toCanonicalBlogCategory(post.data.category),
  topics: canonicalizeBlogTopics(post.data.topics ?? []),
  tags: canonicalizeTags(post.data.tags ?? []),
  oneSmallAction: post.data.oneSmallAction ?? null,
  sourceChannel: post.data.sourceChannel,
  earlyRelease: post.data.earlyRelease ?? false,
}));
---

<BaseLayout title="Blog | Economy for Everyone">
  <section class="section-grid">
    <div class="ledger-header">
      <h2 class="title-reset">Blog</h2>
      <p class="muted-note">
        Canonical long-form posts, migrated and normalized from working-note channels.
      </p>
    </div>

    <BlogBrowser client:load items={postIndex} />

    <noscript>
      {
        visiblePosts.length === 0 ? (
          <div class="panel guardrail-card">
            <p class="claim">No published blog posts yet.</p>
          </div>
        ) : (
          <ol class="timeline-list">
            {visiblePosts.map((post) => (
              <li class="panel timeline-item receipt-card">
                <p class="eyebrow">
                  {getBlogCategoryLabel(toCanonicalBlogCategory(post.data.category))} |{' '}
                  {post.data.pubDate.toISOString().slice(0, 10)} |{' '}
                  {getSourceChannelLabel(post.data.sourceChannel)}
                </p>
                <h3 class="title-reset case-study-title">{post.data.title}</h3>
                <p>{post.data.description}</p>
                <p>
                  <a class="case-read-link" href={`/blog/${post.slug}/`}>
                    Read full post
                  </a>
                </p>
              </li>
            ))}
          </ol>
        )
      }
    </noscript>
  </section>
</BaseLayout>
