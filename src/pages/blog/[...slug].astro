---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status === 'published');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const receiptGroups = await getCollection('receipts', ({ data }) => data.status === 'published');

const receiptTypes = new Map([
  ['primary-documents', 'Primary documents'],
  ['official-data', 'Official data'],
  ['independent-analysis', 'Independent analysis'],
  ['direct-observation', 'Direct observation'],
]);

const relatedReceiptGroups = receiptGroups.filter((group) =>
  (group.data.linkedPostSlugs ?? []).includes(post.slug)
);

const relatedMethodTypes = [
  ...new Set(relatedReceiptGroups.map((group) => group.data.typeId).filter(Boolean)),
].map((typeId) => ({
  id: typeId,
  label: receiptTypes.get(typeId) ?? typeId.replaceAll('-', ' '),
  count: relatedReceiptGroups.filter((group) => group.data.typeId === typeId).length,
}));

const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');
const postPubDates = Object.fromEntries(
  allPosts.map((entry) => [entry.slug, entry.data.pubDate.toISOString()])
);

const oneSmallActionParts = (() => {
  const text = post.data.oneSmallAction?.trim();
  if (!text) return [];

  const matches = [...text.matchAll(/(Ask|Do|Share):/g)];
  if (matches.length === 0) return [{ label: null, text }];

  return matches.map((match, index) => {
    const start = match.index ?? 0;
    const nextStart =
      index + 1 < matches.length ? (matches[index + 1].index ?? text.length) : text.length;
    const label = match[1];
    const bodyStart = start + match[0].length;
    const body = text.slice(bodyStart, nextStart).trim();
    return { label, text: body };
  });
})();
---

<BaseLayout title={`${post.data.title} | Blog | Economy for Everyone`}>
  <section class="section-grid prose-e4e">
    <p class="detail-top-actions no-print">
      <a href="/blog">Back to blog</a>
      <span class="detail-action-group">
        <button
          type="button"
          class="print-button icon-button"
          data-print-page
          title="Opens your browser print dialog."
          aria-label="Print or save as PDF"
        >
          <span aria-hidden="true">[pdf]</span>
        </button>
      </span>
    </p>

    <div class="ledger-header">
      <h2 class="title-reset">{post.data.title}</h2>
      <p class="muted-note">
        {post.data.category} | {post.data.pubDate.toISOString().slice(0, 10)} | {
          post.data.sourceChannel
        }
      </p>
    </div>

    <div class="panel receipt-card">
      <p>{post.data.description}</p>
      {
        oneSmallActionParts.length > 0 && (
          <p class="muted-note">
            <strong>One small action:</strong>{' '}
            {oneSmallActionParts.map((part, index) => (
              <>
                {index > 0 && ' '}
                {part.label ? <strong>{part.label}:</strong> : null}
                {part.label ? ' ' : null}
                {part.text}
              </>
            ))}
          </p>
        )
      }
    </div>

    {
      relatedMethodTypes.length > 0 && (
        <p class="case-meta-inline muted-note">
          <strong>Receipts:</strong> tracked in Methods and Sources by type:{' '}
          {relatedMethodTypes.map((type, index) => (
            <>
              {index > 0 && ' | '}
              <a href={`/methods-and-sources?post=${post.slug}&type=${type.id}#receipt-groups`}>
                {type.label}
              </a>
            </>
          ))}
        </p>
      )
    }
    <div id="blog-content" data-post-pub-dates={JSON.stringify(postPubDates)}>
      <Content />
    </div>

    {
      relatedReceiptGroups.length > 0 && (
        <div class="panel">
          <p class="eyebrow">Related methods</p>
          <p class="muted-note">
            <a href={`/methods-and-sources?post=${post.slug}#receipt-groups`}>
              View receipt groups filtered to this blog post
            </a>
          </p>
          {relatedMethodTypes.length > 0 && (
            <p class="muted-note">
              <strong>By type:</strong>{' '}
              {relatedMethodTypes.map((type, index) => (
                <>
                  {index > 0 && ' | '}
                  <a href={`/methods-and-sources?post=${post.slug}&type=${type.id}#receipt-groups`}>
                    {type.label} ({type.count})
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      )
    }

    <p>
      <a href="/blog">Back to blog</a>
    </p>
  </section>
</BaseLayout>

<script>
  import { downgradeFutureBlogLinks } from '../../utils/blog-future-links';

  const blogContent = document.getElementById('blog-content');
  const rawPubDates = JSON.parse(blogContent?.getAttribute('data-post-pub-dates') || '{}');
  const postPubDates = new Map(
    typeof rawPubDates === 'object' && rawPubDates !== null
      ? Object.entries(rawPubDates).filter(([, v]) => typeof v === 'string')
      : []
  ) as Map<string, string>;

  // Keep references visible, but disable links to future-dated blog posts.
  if (blogContent) downgradeFutureBlogLinks(blogContent, postPubDates);

  document.querySelectorAll('[data-print-page]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>
