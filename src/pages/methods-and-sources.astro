---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReceiptCard from '../components/ReceiptCard.astro';
---

<BaseLayout title="Methods and Sources | Economy for Everyone">
  <section class="section-grid">
    <div class="ledger-header">
      <h2 class="title-reset">Methods and Sources</h2>
    </div>
    <p class="prose-e4e">
      Method: name the feeling, test the story with facts, state it cleanly, do one useful thing,
      stay awake.
    </p>
    <ReceiptCard
      claim="This publication distinguishes between observed facts, inferred patterns, and open uncertainty."
      source="Editorial policy"
      href="#"
      confidence="High"
    />
  </section>
</BaseLayout>
