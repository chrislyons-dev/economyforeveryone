---
import BaseLayout from '../layouts/BaseLayout.astro';
import OneSmallAction from '../components/OneSmallAction.astro';
---

<BaseLayout title="Playbooks | Economy for Everyone">
  <section class="section-grid">
    <div class="ledger-header">
      <h2 class="title-reset">Playbooks</h2>
    </div>
    <p class="prose-e4e">
      Practical guidance for individuals, teams, and communities. Every playbook ends with one
      concrete next step.
    </p>
    <OneSmallAction
      action="Use this section to publish operator briefs and field-tested actions from your 05/06 outputs."
    />
  </section>
</BaseLayout>
